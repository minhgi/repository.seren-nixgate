<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
	<coordinates>
		<left>0</left>
		<top>0</top>
		<width>1920</width>
		<height>1080</height>
	</coordinates>

	<defaultcontrol always="true">1000</defaultcontrol>

	<controls>

		<!-- Background -->
		<control type="group">
			<top>0</top>
			<left>0</left>
			<width>1920</width>
			<height>1080</height>

			<control type="image">
				<texture>white.png</texture>
				<colordiffuse>FF000000</colordiffuse>
			</control>

			<control type="image">
				<texture background="true">$INFO[Window().Property(seren.fanart)]</texture>
				<colordiffuse>66FFFFFF</colordiffuse>
			</control>

			<control type="image">
				<texture background="true">white.png</texture>
				<colordiffuse>CC000000</colordiffuse>
			</control>
		</control>

		<!-- Title -->
		<control type="label">
			<top>25</top>
			<left>40</left>
			<width>100%</width>
			<height>50</height>
			<label>[UPPERCASE][COLOR $INFO[Window().Property(settings.color)]]Seren[/COLOR] - $ADDON[plugin.video.seren 31472][/UPPERCASE]</label>
			<font>font37</font>
			<textcolor>white</textcolor>
		</control>

		<!-- Scrollbar -->
		<control type="scrollbar" id="1111">
			<left>10</left>
			<top>110</top>
			<width>20</width>
			<height>890</height>
			<onright>1000</onright>
			<showonepage>false</showonepage>
			<texturesliderbackground colordiffuse="99362e33">white.png</texturesliderbackground>
			<texturesliderbar colordiffuse="66FFFFFF">white.png</texturesliderbar>
			<texturesliderbarfocus colordiffuse="$INFO[Window().Property(settings.color)]">white.png</texturesliderbarfocus>
		</control>

		<!-- Episode list -->
		<control type="list" id="1000">
			<viewtype label="Calendar">list</viewtype>
			<pagecontrol>1111</pagecontrol>
			<onleft>1111</onleft>
			<onright>2000</onright>
			<left>40</left>
			<top>100</top>
			<width>1340</width>
			<height>900</height>
			<itemgap>20</itemgap>
			<orientation>vertical</orientation>

			<!-- Unfocused episode row -->
			<itemlayout height="160">
				<control type="group">
					<width>1200</width>

					<control type="image">
						<top>10</top>
						<texture>white.png</texture>
						<colordiffuse>99362e33</colordiffuse>
					</control>

					<control type="group">
						<left>20</left>

						<control type="label">
							<top>25</top>
							<width>1150</width>
							<height>50</height>
							<font>font12</font>
							<textcolor>66FFFFFF</textcolor>
							<align>left</align>
							<label>[B]$INFO[ListItem.Label][/B]</label>
						</control>

						<control type="label">
							<top>75</top>
							<width>1150</width>
							<height>20</height>
							<font>font12</font>
							<textcolor>66FFFFFF</textcolor>
							<align>left</align>
							<visible>!String.IsEqual(ListItem.Property(is_upcoming),True)</visible>
							<label>[UPPERCASE]$INFO[ListItem.Property(air_date_label)][/UPPERCASE]</label>
						</control>
						<control type="label">
							<top>75</top>
							<width>1150</width>
							<height>20</height>
							<font>font12</font>
							<textcolor>$INFO[Window().Property(settings.color)]</textcolor>
							<align>left</align>
							<visible>String.IsEqual(ListItem.Property(is_upcoming),True)</visible>
							<label>[UPPERCASE]$INFO[ListItem.Property(air_date_label)][/UPPERCASE]</label>
						</control>

						<control type="label">
							<top>110</top>
							<width>1150</width>
							<height>20</height>
							<font>font12</font>
							<textcolor>66FFFFFF</textcolor>
							<align>left</align>
							<visible>!String.IsEmpty(ListItem.Property(rating_tmdb))</visible>
							<label>[UPPERCASE]$ADDON[plugin.video.seren 31473]: $INFO[ListItem.Property(rating_tmdb)][/UPPERCASE]</label>
						</control>
					</control>
				</control>
			</itemlayout>

			<!-- Unfocused episode row -->
			<focusedlayout height="160" condition="!Control.HasFocus(1000)">
				<control type="group">
					<width>1200</width>

					<control type="image">
						<top>10</top>
						<texture>white.png</texture>
						<colordiffuse>99362e33</colordiffuse>
					</control>

					<control type="group">
						<left>20</left>

						<control type="label">
							<top>25</top>
							<width>1150</width>
							<height>50</height>
							<font>font12</font>
							<textcolor>66FFFFFF</textcolor>
							<align>left</align>
							<label>[B]$INFO[ListItem.Label][/B]</label>
						</control>

						<control type="label">
							<top>75</top>
							<width>1150</width>
							<height>20</height>
							<font>font12</font>
							<textcolor>66FFFFFF</textcolor>
							<align>left</align>
							<visible>!String.IsEqual(ListItem.Property(is_upcoming),True)</visible>
							<label>[UPPERCASE]$INFO[ListItem.Property(air_date_label)][/UPPERCASE]</label>
						</control>
						<control type="label">
							<top>75</top>
							<width>1150</width>
							<height>20</height>
							<font>font12</font>
							<textcolor>$INFO[Window().Property(settings.color)]</textcolor>
							<align>left</align>
							<visible>String.IsEqual(ListItem.Property(is_upcoming),True)</visible>
							<label>[UPPERCASE]$INFO[ListItem.Property(air_date_label)][/UPPERCASE]</label>
						</control>

						<control type="label">
							<top>110</top>
							<width>1150</width>
							<height>20</height>
							<font>font12</font>
							<textcolor>66FFFFFF</textcolor>
							<align>left</align>
							<visible>!String.IsEmpty(ListItem.Property(rating_tmdb))</visible>
							<label>[UPPERCASE]$ADDON[plugin.video.seren 31473]: $INFO[ListItem.Property(rating_tmdb)][/UPPERCASE]</label>
						</control>
					</control>
				</control>
			</focusedlayout>

			<!-- Focused episode row -->
			<focusedlayout height="270" condition="Control.HasFocus(1000)">
				<control type="group">
					<width>1340</width>

					<control type="image">
						<top>10</top>
						<height>260</height>
						<texture>white.png</texture>
						<colordiffuse>FF362e33</colordiffuse>
					</control>

					<control type="group">
						<top>40</top>
						<left>20</left>
						<width>200</width>
						<height>200</height>

						<control type="image">
							<aspectratio>keep</aspectratio>
							<texture>$INFO[Window().Property(seren.logo)]</texture>
							<visible>String.IsEmpty(ListItem.Art(poster))</visible>
						</control>

						<control type="image">
							<aspectratio>keep</aspectratio>
							<texture>$INFO[ListItem.Art(poster)]</texture>
							<visible>!String.IsEmpty(ListItem.Art(poster))</visible>
						</control>
					</control>

					<control type="group">
						<left>240</left>

						<control type="label">
							<top>40</top>
							<width>1080</width>
							<height>30</height>
							<font>font12</font>
							<textcolor>FFFFFFFF</textcolor>
							<align>left</align>
							<label>[B][UPPERCASE]$INFO[ListItem.Label][/UPPERCASE][/B]</label>
						</control>

						<control type="label">
							<top>80</top>
							<width>1080</width>
							<height>20</height>
							<font>font12</font>
							<textcolor>FFFFFFFF</textcolor>
							<align>left</align>
							<label>[B][UPPERCASE][COLOR $INFO[Window().Property(settings.color)]]$INFO[ListItem.Property(air_date_label)][/COLOR][/UPPERCASE][/B]</label>
						</control>

						<control type="label">
							<top>110</top>
							<width>1080</width>
							<height>20</height>
							<font>font12</font>
							<textcolor>FFFFFFFF</textcolor>
							<align>left</align>
							<visible>!String.IsEmpty(ListItem.Property(rating_tmdb))</visible>
							<label>[UPPERCASE]$ADDON[plugin.video.seren 31473]: $INFO[ListItem.Property(rating_tmdb)][/UPPERCASE]</label>
						</control>

						<control type="textbox">
							<top>145</top>
							<width>1080</width>
							<height>100</height>
							<font>font12</font>
							<textcolor>66FFFFFF</textcolor>
							<label>$INFO[ListItem.Plot]</label>
						</control>
					</control>
				</control>
			</focusedlayout>
		</control>

		<!-- Buttons -->
		<control type="group">
			<top>110</top>
			<right>20</right>
			<width>500</width>

			<control type="group">
				<height>110</height>

				<control type="image">
					<texture>white.png</texture>
					<colordiffuse>99362e33</colordiffuse>
				</control>

				<control type="grouplist" id="2000">
					<top>25</top>
					<onleft>1000</onleft>
					<itemgap>10</itemgap>

					<!-- Close -->
					<control type="button" id="2999">
						<height>80</height>
						<textoffsetx>20</textoffsetx>
						<texturefocus colordiffuse="$INFO[Window().Property(settings.color)]">white.png</texturefocus>
						<texturenofocus colordiffuse="22000000">white.png</texturenofocus>
						<label>$ADDON[plugin.video.seren 30459]</label>
						<align>right</align>
						<textcolor>FFFFFFFF</textcolor>
					</control>
				</control>
			</control>
		</control>
	</controls>
</window>
